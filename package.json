{
  "name": "shallow-t-write",
  "version": "0.1.0",
  "description": "Mac-native proofreading assistant inspired by DeepL Write",
  "main": "out/main/main.js",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build": "bun run typecheck && electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "jp.shinji.shallowtwrite",
    "productName": "ShallowT Write",
    "files": [
      "out/**",
      "assets/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      },
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@swc/core": "^1.11.24",
    "electron": "^37.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
