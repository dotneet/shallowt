{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "types": ["node", "electron"],
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "electron.vite.config.ts",
    "electron/**/*.ts"
  ]
}
